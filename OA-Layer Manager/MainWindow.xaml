<Window x:Class="OA.LayerBatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OA Layer Manager" Height="500" Width="900"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#007ACC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0098FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3E3E42"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3E3E42"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#252526" Padding="20,15" CornerRadius="8" Margin="0,0,0,15">
            <TextBlock Text="OA LAYER MANAGER" Foreground="#007ACC" FontSize="22" FontWeight="Bold"/>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#252526" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <Button Content="Select Files" Width="100" Margin="0,0,10,0" Click="SelectFiles_Click"/>
                <Button Content="Select Folder" Width="110" Margin="0,0,15,0" Click="SelectFolder_Click"/>
                <TextBlock x:Name="FolderPathText" Text="No files selected" VerticalAlignment="Center" Foreground="#AAAAAA" FontStyle="Italic" Width="400" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000"/>
                <Button x:Name="ScanButton" Content="Scan DWGs" Width="100" Margin="15,0,0,0" Click="Scan_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="2" Background="#252526" Padding="10,8" CornerRadius="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAAAAA" FontSize="14"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" Foreground="White" CaretBrush="White"
                         BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="0,2,0,0"
                         TextChanged="SearchBox_TextChanged">
                </TextBox>
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search layer name..." Foreground="#666666"
                           FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button x:Name="ClearSearchButton" Grid.Column="2" Content="✕" Width="20" Height="20"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                        Visibility="Collapsed" Click="ClearSearch_Click" FontSize="11"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="3" CornerRadius="8" Background="#252526" Padding="2" Margin="0,0,0,15" x:Name="DataGridBorder">
            <DataGrid x:Name="MappingGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Layer Name" Binding="{Binding LayerName}" Width="2*" IsReadOnly="True"/>
                    <DataGridComboBoxColumn x:Name="ColorColumn" Header="New Color" SelectedItemBinding="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                    <DataGridComboBoxColumn x:Name="WeightColumn" Header="New Lineweight" SelectedItemBinding="{Binding LineWeightName, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                    <DataGridComboBoxColumn x:Name="LinetypeColumn" Header="New Linestyle" SelectedItemBinding="{Binding LinestyleName, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress section (hidden when idle) -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock x:Name="ProgressStatusText" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#333333" Foreground="#007ACC"
                             BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Border x:Name="PART_Track" CornerRadius="4">
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton" Content="Apply Changes" Width="150" Height="35" Click="Apply_Click" Style="{StaticResource PrimaryButton}" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>